@@ -0,0 +1,150 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Pionix GmbH and Contributors to EVerest
+
+// Top-level EVSE SLAC machine: event processing, the exit point queue, and the two top-level
+// states that are no sub-machine, Idle and Failed.
+
+#include "machine.hpp"
+
+#include <everest/slac/telemetry.hpp>
+
+#include <cstdio>
+#include <string>
+#include <utility>
+
+namespace everest::lib::slac::sm::evse {
+
+namespace {
+
+struct Idle : TopLevelState<StateId::Idle> {
+    explicit Idle(SlacMachine& m) : TopLevelState(m, "Idle") {
+    }
+    void enter() override {
+        ctx.enter_state(SlacState::Idle, D3State::Unmatched, "Entered Idle state");
+        ctx.clear_match_confirm_cache();
+        ctx.status.modem_PIB = true;
+    }
+    bool reacts_to(EventId e) const override {
+        return reacts_to_any(e, {EventId::enter_bcd, EventId::reset});
+    }
+    Result feed(Event const& e) override {
+        if (e.is(EventId::enter_bcd)) {
+            return transition(make_matching(machine));
+        }
+        if (e.is(EventId::reset)) {
+            return transition(make_reset(machine));
+        }
+        return unhandled();
+    }
+};
+
+struct Failed : TopLevelState<StateId::Failed> {
+    explicit Failed(SlacMachine& m) : TopLevelState(m, "Failed") {
+    }
+    void enter() override {
+        ctx.enter_state(SlacState::Failed, D3State::Unmatched, "Entered Failed state");
+        if (ctx.slac_config.ac_mode_five_percent) {
+            ctx.signal_error_routine_request();
+        }
+        ctx.clear_match_confirm_cache();
+    }
+    bool reacts_to(EventId e) const override {
+        return reacts_to_any(e, {EventId::reset, EventId::leave_bcd});
+    }
+    Result feed(Event const& e) override {
+        if (e.is(EventId::reset) or e.is(EventId::leave_bcd)) {
+            return transition(make_reset(machine));
+        }
+        return unhandled();
+    }
+};
+
+} // namespace
+
+TopStatePtr make_idle(SlacMachine& machine) {
+    return std::make_unique<Idle>(machine);
+}
+
+TopStatePtr make_failed(SlacMachine& machine) {
+    return std::make_unique<Failed>(machine);
+}
+
+SlacMachine::SlacMachine(fsm::evse::Context& ctx_) : ctx(ctx_) {
+}
+
+SlacMachine::~SlacMachine() {
+    destroying = true;
+}
+
+void SlacMachine::start() {
+    top.start(make_init(*this));
+    top.complete();
+    while (not queue.empty()) {
+        auto queued = std::move(queue.front());
+        queue.pop_front();
+        process_one(queued.view());
+    }
+}
+
+void SlacMachine::stop() {
+    top.stop();
+}
+
+void SlacMachine::forward(QueuedEvent e) {
+    queue.push_back(std::move(e));
+}
+
+void SlacMachine::process(Event const& e) {
+    process_one(e);
+    // Exit points reached meanwhile queued their event; it is processed now, in whatever state
+    // the machine is in by then.
+    while (not queue.empty()) {
+        auto queued = std::move(queue.front());
+        queue.pop_front();
+        process_one(queued.view());
+    }
+}
+
+void SlacMachine::process_one(Event const& e) {
+    auto const reacts = top.current().reacts_to(e.id);
+    if (top.feed(e)) {
+        top.complete();
+        return;
+    }
+    if (not reacts) {
+        log_no_transition(e);
+    }
+}
+
+// An event no row handles in the current state is dropped. Frames and commands that arrive in the
+// wrong state are worth a debug line; an idle update or a completion is not.
+void SlacMachine::log_no_transition(Event const& e) {
+    auto const state = std::string(top.current().name());
+    switch (e.id) {
+    case EventId::message: {
+        char mmtype[8];
+        std::snprintf(mmtype, sizeof(mmtype), "%x", static_cast<unsigned>(e.payload->get_mmtype()));
+        ctx.log_debug(std::string("Ignoring SLAC message 0x") + mmtype + " in state " + state);
+        break;
+    }
+    case EventId::reset:
+        ctx.log_debug("Ignoring reset in state " + state);
+        break;
+    case EventId::enter_bcd:
+        ctx.log_debug("Ignoring enter_bcd in state " + state);
+        break;
+    case EventId::leave_bcd:
+        ctx.log_debug("Ignoring leave_bcd in state " + state);
+        break;
+    default:
+        break;
+    }
+}
+
+void SlacMachine::traverse(Visitor& visitor) const {
+    if (top.active()) {
+        top.traverse(visitor, 0);
+    }
+}
+
+} // namespace everest::lib::slac::sm::evse
diff --git a/slac/src/fsm/evse/machine.hpp b/slac/src/fsm/evse/machine.hpp
new file mode 100644
index 0000000..d9ef795
--- /dev/null
+++ b/slac/src/fsm/evse/machine.hpp
@@ -0,0 +1,246 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Pionix GmbH and Contributors to EVerest
+
+// EVSE SLAC state machine on fsm::v2 (see fsm_helpers.hpp for the execution model).
+//
+// Top level:  Init -> Reset -> [ResetChip ->] Idle -> Matching -> [WaitForLink ->] Matched
+//             with Failed reachable from Reset, Matching and WaitForLink, and reset / leave_bcd
+//             leading back to Reset or Idle.
+// Each top-level state except Idle and Failed is a sub-machine defined in its own source file;
+// they create each other through the make_* factories below.
+
+#pragma once
+
+#include "../fsm_helpers.hpp"
+#include "amp_map_handler.hpp"
+#include "validate_handler.hpp"
+
+#include <everest/slac/MatchingSessionData.hpp>
+#include <everest/slac/fsm/evse/context.hpp>
+#include <everest/slac/slac_types.hpp>
+#include <everest/slac/timer.hpp>
+
+#include <chrono>
+#include <deque>
+#include <initializer_list>
+#include <memory>
+#include <vector>
+
+namespace everest::lib::slac::sm::evse {
+
+// Ids of every state of the EVSE machines, sub-machine states included.
+enum class StateId : int {
+    // top level
+    Init,
+    Reset,
+    ResetChip,
+    Idle,
+    Matching,
+    WaitForLink,
+    Matched,
+    Failed,
+    // Init
+    InitQuery,
+    InitOpAttr,
+    InitGetVersion,
+    InitDone,
+    InitOther,
+    InitLumissil,
+    InitQualcomm,
+    // Reset
+    ResetInit,
+    ResetMsgSent,
+    ResetMsgValid,
+    ResetExitResetChip,
+    ResetExitIdle,
+    // ResetChip
+    ResetChipDelay,
+    ResetChipSent,
+    ResetChipReceived,
+    ResetChipDone,
+    // Matching
+    MatchingInit,
+    MatchingListen,
+    MatchingPipe,
+    MatchingExitMatched,
+    MatchingExitFailed,
+    // Session (one per CM_SLAC_PARM.REQ in Matching)
+    SessionWaitStartAtten,
+    SessionSounding,
+    SessionFinalizeSounding,
+    SessionWaitAttenRsp,
+    SessionWaitSlacMatch,
+    SessionMatchComplete,
+    SessionFailed,
+    // WaitForLink
+    WaitForLinkInit,
+    WaitForLinkLumissil,
+    WaitForLinkQualcomm,
+    WaitForLinkExitFailed,
+    WaitForLinkExitMatched,
+    // Matched
+    MatchedInit,
+    MatchedLumissil,
+    MatchedQualcomm,
+    MatchedNoDetect,
+    MatchedExitFailed,
+};
+
+class SlacMachine;
+
+struct TopTag {};
+using TopState = State<TopTag>;
+using TopStatePtr = TopState::ContainerType;
+
+// Inner states of the sub-machines all share one base type; their ids keep them apart.
+struct InnerTag {};
+using InnerState = State<InnerTag>;
+using InnerRegion = Region<InnerState>;
+
+// A state of the given id and name with no behaviour of its own.
+template <class Base, StateId Id> struct NamedState : Base {
+    explicit NamedState(char const* name_) : state_name(name_) {
+    }
+    char const* name() const override {
+        return state_name;
+    }
+    int id() const override {
+        return static_cast<int>(Id);
+    }
+
+private:
+    char const* state_name;
+};
+
+// Exit point of a sub-machine: entering it forwards the triggering event, as the event type the
+// exit point declares, to the top-level machine (see fsm_helpers.hpp).
+template <StateId Id> struct ExitPoint : NamedState<InnerState, Id> {
+    ExitPoint(SlacMachine& machine_, char const* name_, EventId forwarded_, Event const& trigger_) :
+        NamedState<InnerState, Id>(name_), machine(machine_), forwarded{trigger_} {
+        forwarded.id = forwarded_;
+    }
+    void enter() override;
+
+private:
+    SlacMachine& machine;
+    QueuedEvent forwarded;
+};
+
+// Sub-machine data that lives as long as the machine (it is kept across leaving and re-entering
+// the sub-machine, like the members of a sub-machine definition).
+struct ResetData {
+    Nmk pending_nmk{};
+    int set_key_attempts{0};
+    timer set_key_timer;
+};
+
+class Session;
+
+struct MatchingData {
+    timer to;
+    bool failed_matching_reset_once{false};
+    fsm::evse::ValidateHandler validate; // CM_VALIDATE (ISO 15118-3 9.4) BCB-toggle validation
+    std::vector<std::unique_ptr<Session>> sessions;
+
+    MatchingData();
+    ~MatchingData();
+};
+
+struct WaitForLinkData {
+    std::chrono::milliseconds link_check_to{0};
+    timer to;
+};
+
+struct MatchedData {
+    std::chrono::milliseconds link_check_to{0};
+    int consecutive_neg_link_status{0};
+    int neg_link_status_threshold{1};
+    fsm::evse::AmpMapHandler amp_map; // SECC-initiated CM_AMP_MAP exchange (ISO 15118-3 A.9.6)
+    // Set when Matched is left because the link was lost (the Matched_Fail transition), whose
+    // action runs once the sub-machine has been exited.
+    bool leaving_on_link_loss{false};
+};
+
+class SlacMachine {
+public:
+    explicit SlacMachine(fsm::evse::Context& ctx);
+    // Destroying the machine leaves no state: the exit hooks see shutting_down and skip their
+    // side effects (only stop() leaves the active states).
+    ~SlacMachine();
+    bool shutting_down() const {
+        return destroying;
+    }
+
+    // Enters the initial state; stop() leaves the active states, sub-machines first.
+    void start();
+    void stop();
+
+    // Processes one event to completion, including the events queued by exit points meanwhile.
+    void process(Event const& e);
+
+    // Exit points queue their event here.
+    void forward(QueuedEvent e);
+
+    void traverse(Visitor& visitor) const;
+
+    fsm::evse::Context& ctx;
+    ResetData reset_data;
+    MatchingData matching_data;
+    WaitForLinkData wait_for_link_data;
+    MatchedData matched_data;
+
+private:
+    void process_one(Event const& e);
+    void log_no_transition(Event const& e);
+
+    std::deque<QueuedEvent> queue;
+    bool destroying{false};
+    Region<TopState> top; // last, so that it is destroyed first
+};
+
+inline bool reacts_to_any(EventId e, std::initializer_list<EventId> events) {
+    for (auto const event : events) {
+        if (event == e) {
+            return true;
+        }
+    }
+    return false;
+}
+
+template <StateId Id> void ExitPoint<Id>::enter() {
+    machine.forward(forwarded);
+}
+
+// Top-level states, one factory each.
+TopStatePtr make_init(SlacMachine& machine);
+TopStatePtr make_reset(SlacMachine& machine);
+TopStatePtr make_reset_chip(SlacMachine& machine);
+TopStatePtr make_idle(SlacMachine& machine);
+TopStatePtr make_matching(SlacMachine& machine);
+TopStatePtr make_wait_for_link(SlacMachine& machine);
+TopStatePtr make_matched(SlacMachine& machine);
+TopStatePtr make_failed(SlacMachine& machine);
+
+// Common base of the top-level states.
+template <StateId Id> struct TopLevelState : NamedState<TopState, Id> {
+    TopLevelState(SlacMachine& machine_, char const* name_) :
+        NamedState<TopState, Id>(name_), machine(machine_), ctx(machine_.ctx) {
+    }
+
+protected:
+    SlacMachine& machine;
+    fsm::evse::Context& ctx;
+};
+
+// Common base of the inner states of a sub-machine.
+template <StateId Id> struct InnerLevelState : NamedState<InnerState, Id> {
+    InnerLevelState(SlacMachine& machine_, char const* name_) :
+        NamedState<InnerState, Id>(name_), machine(machine_), ctx(machine_.ctx) {
+    }
+
+protected:
+    SlacMachine& machine;
+    fsm::evse::Context& ctx;
+};
+
+} // namespace everest::lib::slac::sm::evse
diff --git a/slac/src/fsm/evse/matched.cpp b/slac/src/fsm/evse/matched.cpp
new file mode 100644
index 0000000..e2e94b2
--- /dev/null
+++ b/slac/src/fsm/evse/matched.cpp
@@ -0,0 +1,255 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Pionix GmbH and Contributors to EVerest
+
+// Matched sub-machine: the AVLN is up. Polls the modem link status (vendor specific), debounces
+// link loss and runs the CM_AMP_MAP exchange. Leaves through the Failed exit when the link is lost;
+// the top-level machine takes that to Reset.
+//
+//   Init --completion / query link status--> Lumissil | Qualcomm (link detection on), NoDetect (off)
+//   Lumissil|Qualcomm --update / link status poll and CM_AMP_MAP retransmission when due--> (internal)
+//   Lumissil|Qualcomm --message(link status: not linked), debounce count reached--> Failed (exit)
+//   Lumissil|Qualcomm --message(link status: not linked | linked) / count | clear--> (internal)
+//   Lumissil|Qualcomm|NoDetect|Init --message(CM_AMP_MAP.REQ) / answer--> (internal)
+//   Lumissil|Qualcomm|NoDetect --message(awaited CM_AMP_MAP.CNF) / acknowledge--> (internal)
+//   NoDetect --update / CM_AMP_MAP retransmission when due--> (internal)
+//   outer:  reset, leave_bcd --> Reset;  Failed exit --> Reset (connection lost)
+
+#include "../misc.hpp"
+#include "link_status.hpp"
+#include "machine.hpp"
+
+#include <everest/slac/slac_defs.hpp>
+#include <everest/slac/slac_messages.hpp>
+#include <everest/slac/telemetry.hpp>
+
+#include <cstdio>
+#include <string>
+
+namespace everest::lib::slac::sm::evse {
+
+namespace {
+
+// A valid CM_AMP_MAP.REQ (am_len != 0) received while matched. am_len == 0 is
+// invalid and must be left unanswered (ISO 15118-5 CmAmpMap_005).
+bool is_amp_map_req(Event const& e) {
+    if (not e.is(EventId::message)) {
+        return false;
+    }
+    if (e.payload->get_mmtype() != (defs::MMTYPE_CM_AMP_MAP | defs::MMTYPE_MODE_REQ)) {
+        return false;
+    }
+    auto const req = e.payload->payload_as<messages::cm_amp_map_req>();
+    return req.has_value() and req->am_len != 0;
+}
+
+// Answer a valid CM_AMP_MAP.REQ with CM_AMP_MAP.CNF(result=0x00). On real HW
+// the requested transmit-power reduction is applied to the modem; that RF
+// effect is out of scope for the SLAC stack.
+void send_amp_map_cnf(fsm::evse::Context& ctx, Event const& e) {
+    messages::cm_amp_map_cnf reply{};
+    reply.result = defs::CM_AMP_MAP_CNF_RESULT_SUCCESS;
+    if (not ctx.send_slac_message(e.payload->get_src_mac(), reply)) {
+        ctx.log_warn("Failed to send CM_AMP_MAP.CNF");
+    }
+}
+
+// The SECC-initiated CM_AMP_MAP exchange (ISO 15118-3 A.9.6) lives in AmpMapHandler, owned by the
+// Matched data as `amp_map`; these states only wire it to the update tick and to the incoming CNF.
+bool is_amp_map_cnf_ok(MatchedData const& data, Event const& e) {
+    return e.is(EventId::message) and data.amp_map.is_awaited_cnf(*e.payload);
+}
+
+template <class Vendor, StateId Id> struct CheckLink : LinkCheckState<Vendor, Id> {
+    explicit CheckLink(SlacMachine& m) : LinkCheckState<Vendor, Id>(m, m.matched_data.link_check_to) {
+    }
+    typename CheckLink::Result feed(Event const& e) override {
+        auto& ctx = this->ctx;
+        auto& data = this->machine.matched_data;
+        auto const now = ctx.current_time;
+        if (e.is(EventId::update)) {
+            // The update tick serves two timers, the link-status poll and the CM_AMP_MAP
+            // retransmission, in one internal transition so that both run when both are due.
+            auto const poll_due = this->poll_due();
+            auto const retransmit_due = data.amp_map.retransmit_due(now);
+            if (not(poll_due or retransmit_due)) {
+                return this->unhandled();
+            }
+            if (poll_due) {
+                this->poll();
+            }
+            if (data.amp_map.retransmit_due(now)) {
+                data.amp_map.retransmit(ctx);
+            }
+            return this->handled();
+        }
+        if (is_amp_map_cnf_ok(data, e)) {
+            data.amp_map.acknowledge_cnf();
+            return this->handled();
+        }
+        if (is_amp_map_req(e)) {
+            send_amp_map_cnf(ctx, e);
+            return this->handled();
+        }
+        if (this->link_status_cnf(e)) {
+            if (data.consecutive_neg_link_status != 0) {
+                data.consecutive_neg_link_status = 0;
+                ctx.log_info("Positive LINK_STATUS, link recovered; debounce count cleared");
+            }
+            return this->handled();
+        }
+        if (this->link_status_neg(e)) {
+            if (data.consecutive_neg_link_status + 1 >= data.neg_link_status_threshold) {
+                return this->transition(std::make_unique<ExitPoint<StateId::MatchedExitFailed>>(this->machine, "Failed",
+                                                                                                EventId::message, e));
+            }
+            data.consecutive_neg_link_status++;
+            ctx.log_warn("Negative LINK_STATUS while matched (" + std::to_string(data.consecutive_neg_link_status) +
+                         "/" + std::to_string(data.neg_link_status_threshold) +
+                         "), keeping the link up while debouncing");
+            return this->handled();
+        }
+        return this->unhandled();
+    }
+};
+using Lumissil = CheckLink<LumissilLinkStatus, StateId::MatchedLumissil>;
+using Qualcomm = CheckLink<QualcommLinkStatus, StateId::MatchedQualcomm>;
+
+struct NoDetect : InnerLevelState<StateId::MatchedNoDetect> {
+    explicit NoDetect(SlacMachine& m) : InnerLevelState(m, "NoDetect") {
+    }
+    bool reacts_to(EventId e) const override {
+        return reacts_to_any(e, {EventId::update, EventId::message});
+    }
+    Result feed(Event const& e) override {
+        auto& data = machine.matched_data;
+        if (e.is(EventId::update)) {
+            if (data.amp_map.retransmit_due(ctx.current_time)) {
+                data.amp_map.retransmit(ctx);
+                return handled();
+            }
+            return unhandled();
+        }
+        if (is_amp_map_cnf_ok(data, e)) {
+            data.amp_map.acknowledge_cnf();
+            return handled();
+        }
+        if (is_amp_map_req(e)) {
+            send_amp_map_cnf(ctx, e);
+            return handled();
+        }
+        return unhandled();
+    }
+};
+
+struct MatchedInit : InnerLevelState<StateId::MatchedInit> {
+    explicit MatchedInit(SlacMachine& m) : InnerLevelState(m, "Init") {
+    }
+    bool reacts_to(EventId e) const override {
+        return reacts_to_any(e, {EventId::completion, EventId::message});
+    }
+    template <class Target> Result start_polling() {
+        auto target = std::make_unique<Target>(machine);
+        target->poll();
+        return transition(std::move(target));
+    }
+    Result feed(Event const& e) override {
+        if (e.is(EventId::completion)) {
+            auto const detect_link = ctx.slac_config.link_status.do_detect;
+            if (not detect_link) {
+                return transition(std::make_unique<NoDetect>(machine));
+            }
+            if (ctx.modem_vendor == defs::ModemVendor::Qualcomm) {
+                return start_polling<Qualcomm>();
+            }
+            if (ctx.modem_vendor == defs::ModemVendor::Lumissil) {
+                return start_polling<Lumissil>();
+            }
+            return unhandled();
+        }
+        if (is_amp_map_req(e)) {
+            send_amp_map_cnf(ctx, e);
+            return handled();
+        }
+        return unhandled();
+    }
+};
+
+struct Matched : TopLevelState<StateId::Matched> {
+    explicit Matched(SlacMachine& m) : TopLevelState(m, "Matched_def") {
+    }
+    void enter() override {
+        auto& data = machine.matched_data;
+        {
+            char attenuation[24];
+            std::snprintf(attenuation, sizeof(attenuation), "%.1f",
+                          static_cast<double>(ctx.status.average_attenuation));
+            ctx.enter_state(SlacState::Matched, D3State::Matched,
+                            "Entered Matched state (EV " + format_mac_addr(ctx.status.ev_mac) + ", avg. attenuation " +
+                                attenuation + " dB)");
+        }
+        ctx.clear_match_confirm_cache();
+        ctx.signal_dlink_ready(true);
+        data.link_check_to = ctx.slac_config.link_status.poll_in_matched_state;
+        data.consecutive_neg_link_status = 0;
+        data.neg_link_status_threshold =
+            ctx.slac_config.link_status.debounce_count < 1 ? 1 : ctx.slac_config.link_status.debounce_count;
+        data.leaving_on_link_loss = false;
+        ctx.status.modem_link_ready = true;
+        data.amp_map.start(ctx);
+        region.start(std::make_unique<MatchedInit>(machine));
+        region.complete();
+    }
+    void leave() override {
+        region.stop();
+        if (machine.shutting_down()) {
+            return;
+        }
+        ctx.signal_dlink_ready(false);
+        ctx.status.ev_mac.fill(0);
+        ctx.status.average_attenuation = 0.f;
+        ctx.status.modem_link_ready = false;
+        ctx.clear_match_confirm_cache();
+        if (machine.matched_data.leaving_on_link_loss) {
+            machine.matched_data.leaving_on_link_loss = false;
+            ctx.log_error("Connection lost in matched state");
+            ctx.signal_error_routine_request();
+        }
+    }
+    Result feed(Event const& e) override {
+        if (region.feed(e)) {
+            region.complete();
+            return handled();
+        }
+        if (e.is(EventId::reset) or e.is(EventId::leave_bcd)) {
+            return transition(make_reset(machine));
+        }
+        if (e.is(EventId::message) and region.current_id() == static_cast<int>(StateId::MatchedExitFailed)) {
+            machine.matched_data.leaving_on_link_loss = true;
+            return transition(make_reset(machine));
+        }
+        return unhandled();
+    }
+    void deadlines(earliest_deadline& next) const override {
+        machine.matched_data.amp_map.deadlines(next);
+    }
+    bool reacts_to(EventId e) const override {
+        return reacts_to_any(e, {EventId::reset, EventId::leave_bcd}) or region.current().reacts_to(e);
+    }
+    bool is_submachine() const override {
+        return true;
+    }
+    void traverse_children(Visitor& visitor, std::size_t depth) const override {
+        region.traverse(visitor, depth);
+    }
+
+private:
+    InnerRegion region;
+};
+
+} // namespace
+
+TopStatePtr make_matched(SlacMachine& machine) {
+    return std::make_unique<Matched>(machine);
+}
+
+} // namespace everest::lib::slac::sm::evse
diff --git a/slac/src/fsm/evse/matching.cpp b/slac/src/fsm/evse/matching.cpp
new file mode 100644
index 0000000..c375ee8
--- /dev/null
+++ b/slac/src/fsm/evse/matching.cpp
@@ -0,0 +1,618 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Pionix GmbH and Contributors to EVerest
+
+// Matching sub-machine: answers CM_SLAC_PARM.REQ, runs one Session per EV (several in parallel for
+// cross-talk), the CM_VALIDATE exchange, and exits to Matched or Failed.
+//
+//   region 0 (Init):   update / a session matched           --> Matched (exit)
+//                      update / all failed or init timeout  --> Failed (exit), or once restarts
+//                                                               Matching when reset_instead_of_fail
+//   region 1 (Listen): message(CM_SLAC_PARM.REQ) / add or restart the EV's session
+//                      message(CM_VALIDATE.REQ)  / CM_VALIDATE handling
+//                      update / CM_VALIDATE timer service
+//   region 2 (Pipe):   every other message and every update go to all sessions
+//   outer:             reset --> Reset; leave_bcd --> Idle; Matched exit --> WaitForLink | Matched;
+//                      Failed exit --> Failed
+//
+// Session, one per CM_SLAC_PARM.REQ, from CM_START_ATTEN_CHAR.IND to CM_SLAC_MATCH.CNF:
+//   WaitStartAtten --message(CM_START_ATTEN_CHAR.IND)--> Sounding
+//   Sounding --message(CM_ATTEN_PROFILE.IND)--> Sounding | FinalizeSounding (all sounds captured)
+//   Sounding --update/timeout--> FinalizeSounding
+//   FinalizeSounding --update/timeout / send CM_ATTEN_CHAR.IND--> WaitAttenRsp
+//   WaitAttenRsp --update/timeout / resend--> WaitAttenRsp (up to C_EV_match_retry), then Failed
+//   WaitAttenRsp --message(CM_ATTEN_CHAR.RSP)--> WaitSlacMatch
+//   WaitSlacMatch --message(CM_SLAC_MATCH.REQ) / send CM_SLAC_MATCH.CNF--> MatchComplete
+//   WaitSlacMatch --update/timeout or post-validation window expired--> Failed
+
+#include "../misc.hpp"
+#include "machine.hpp"
+
+#include <everest/slac/MatchingSessionData.hpp>
+#include <everest/slac/slac_defs.hpp>
+#include <everest/slac/slac_messages.hpp>
+#include <everest/slac/slac_types.hpp>
+#include <everest/slac/telemetry.hpp>
+
+#include <algorithm>
+#include <cstdio>
+#include <string>
+
+namespace everest::lib::slac::sm::evse {
+
+// One EV's SLAC run.
+class Session {
+public:
+    Session() = default;
+    Session(Session const&) = delete;
+    Session& operator=(Session const&) = delete;
+
+    void start();
+    void process(Event const& e) {
+        region.feed(e);
+    }
+    bool matched() const {
+        return region.current_id() == static_cast<int>(StateId::SessionMatchComplete);
+    }
+    bool failed() const {
+        return region.current_id() == static_cast<int>(StateId::SessionFailed);
+    }
+    void traverse(Visitor& visitor, std::size_t depth) const {
+        region.traverse(visitor, depth);
+    }
+
+    struct Tag {};
+    using StateBase = State<Tag>;
+
+    fsm::evse::MatchingSessionData session_data;
+    fsm::evse::Context* ctx{nullptr};
+
+private:
+    Region<StateBase> region;
+};
+
+MatchingData::MatchingData() = default;
+MatchingData::~MatchingData() = default;
+
+namespace {
+
+// Message checks: the frame has the expected MMTYPE, decodes as MsgT and belongs to this session
+// (run id / EV MAC, see MatchingSessionData::validate_message).
+template <class MsgT>
+bool check_message(Event const& e, std::uint16_t expected, fsm::evse::MatchingSessionData const& session_data) {
+    if (not e.is(EventId::message)) {
+        return false;
+    }
+    const auto mmtype = e.payload->get_mmtype();
+    if (mmtype not_eq expected) {
+        return false;
+    }
+    auto const msg = e.payload->template payload_as<MsgT>();
+    if (not msg.has_value()) {
+        return false;
+    }
+    return session_data.validate_message(*msg);
+}
+bool matches_start_atten_char(Event const& e, fsm::evse::MatchingSessionData const& session_data) {
+    return check_message<messages::cm_start_atten_char_ind>(e, defs::MMTYPE_CM_START_ATTEN_CHAR | defs::MMTYPE_MODE_IND,
+                                                            session_data);
+}
+bool matches_atten_char_rsp(Event const& e, fsm::evse::MatchingSessionData const& session_data) {
+    return check_message<messages::cm_atten_char_rsp>(e, defs::MMTYPE_CM_ATTEN_CHAR | defs::MMTYPE_MODE_RSP,
+                                                      session_data);
+}
+bool matches_slac_match_req(Event const& e, fsm::evse::MatchingSessionData const& session_data) {
+    return check_message<messages::cm_slac_match_req>(e, defs::MMTYPE_CM_SLAC_MATCH | defs::MMTYPE_MODE_REQ,
+                                                      session_data);
+}
+bool matches_atten_profile_ind(Event const& e, fsm::evse::MatchingSessionData const& session_data) {
+    return check_message<messages::cm_atten_profile_ind>(e, defs::MMTYPE_CM_ATTEN_PROFILE | defs::MMTYPE_MODE_IND,
+                                                         session_data);
+}
+
+using SessionState = Session::StateBase;
+
+template <StateId Id> struct SessionLevelState : SessionState {
+    SessionLevelState(Session& session_, char const* name_, std::chrono::milliseconds timeout = {}) :
+        session(session_), ctx(*session_.ctx), state_name(name_) {
+        state_timer.duration = timeout;
+    }
+    char const* name() const override {
+        return state_name;
+    }
+    int id() const override {
+        return static_cast<int>(Id);
+    }
+    void enter() override {
+        state_timer.arm(ctx.current_time);
+    }
+    void deadlines(earliest_deadline& next) const override {
+        state_timer.deadlines(next);
+    }
+    bool timed_out() const {
+        return state_timer.state_timeout(ctx.current_time);
+    }
+    void log_failed(char const* reason) {
+        ctx.log_info(session_log_prefix(session.session_data) + reason);
+    }
+
+protected:
+    Session& session;
+    fsm::evse::Context& ctx;
+
+private:
+    StateTimer state_timer;
+    char const* state_name;
+};
+
+// A state without a timer of its own; it only flags the session's outcome.
+template <StateId Id> struct SessionEndState : SessionState {
+    explicit SessionEndState(char const* name_) : state_name(name_) {
+    }
+    char const* name() const override {
+        return state_name;
+    }
+    int id() const override {
+        return static_cast<int>(Id);
+    }
+
+private:
+    char const* state_name;
+};
+using MatchComplete = SessionEndState<StateId::SessionMatchComplete>;
+using SessionFailed = SessionEndState<StateId::SessionFailed>;
+
+std::unique_ptr<SessionState> make_session_failed() {
+    return std::make_unique<SessionFailed>("Failed");
+}
+
+void send_atten_char(Session& session) {
+    auto& ctx = *session.ctx;
+    auto& data = session.session_data;
+    auto atten_char = data.create_cm_atten_char_ind(ctx.slac_config.sounding_atten_adjustment);
+    if (not ctx.send_slac_message(data.ev_mac, atten_char)) {
+        ctx.log_warn("Failed to send CM_ATTEN_CHAR.IND");
+    }
+    int aag_overall_sum = 0;
+    for (size_t i = 0; i < defs::AAG_LIST_LEN; ++i) {
+        aag_overall_sum += atten_char.attenuation_profile.aag[i];
+    }
+    ctx.status.average_attenuation = aag_overall_sum / defs::AAG_LIST_LEN;
+    char average[24];
+    std::snprintf(average, sizeof(average), "%.1f", static_cast<double>(aag_overall_sum) / defs::AAG_LIST_LEN);
+    std::string text = std::string("Avg atten.: ") + average + " dB";
+    if (ctx.slac_config.sounding_atten_adjustment != 0) {
+        text += " plus offset " + std::to_string(ctx.slac_config.sounding_atten_adjustment) + " dB";
+    }
+    text +=
+        ", from " + std::to_string(defs::AAG_LIST_LEN) + " groups, " + std::to_string(data.captured_sounds) + " sounds";
+    ctx.log_info(session_log_prefix(data) + text);
+}
+
+struct WaitSlacMatch : SessionLevelState<StateId::SessionWaitSlacMatch> {
+    explicit WaitSlacMatch(Session& s) :
+        SessionLevelState(s, "WaitSlacMatch", std::chrono::milliseconds(defs::TT_EVSE_MATCH_SESSION_MS)) {
+    }
+    // After a CM_VALIDATE process, the CM_SLAC_MATCH.REQ must arrive within TT_match_sequence (much
+    // shorter than the overall TT_EVSE_match_session that bounds WaitSlacMatch otherwise). When that
+    // shorter window elapses the matching has FAILED (ISO 15118-5 CmSlacMatch_003/004 cmValidate
+    // variant); a late CM_SLAC_MATCH.REQ must then get no CM_SLAC_MATCH.CNF.
+    // Only the validated EV's session is held to the post-validation window; a parallel session of
+    // another EV keeps the full match session timeout.
+    bool validation_window_expired() const {
+        return ctx.validation_done and session.session_data.ev_mac == ctx.validation_ev_mac and
+               ctx.validation_match_window.expired(ctx.current_time);
+    }
+    Result feed(Event const& e) override {
+        if (e.is(EventId::update)) {
+            if (validation_window_expired()) {
+                log_failed("No CM_SLAC_MATCH.REQ within TT_match_sequence after CM_VALIDATE, session failed");
+                return transition(make_session_failed());
+            }
+            if (timed_out()) {
+                log_failed("Timeout waiting for CM_SLAC_MATCH.REQ, session failed");
+                return transition(make_session_failed());
+            }
+            return unhandled();
+        }
+        if (matches_slac_match_req(e, session.session_data)) {
+            send_match_cnf(e);
+            return transition(std::make_unique<MatchComplete>("MatchComplete"));
+        }
+        return unhandled();
+    }
+    void send_match_cnf(Event const& e) {
+        auto& data = session.session_data;
+        messages::cm_slac_match_cnf& reply = ctx.match_confirm_cache.message;
+        auto const msg = e.payload->payload_as<messages::cm_slac_match_req>();
+        if (not msg.has_value()) {
+            return;
+        }
+        ctx.log_info(session_log_prefix(data) +
+                     "Received CM_SLAC_MATCH.REQ, sending CM_SLAC_MATCH.CNF -> session complete");
+        static constexpr Nmk failed_match_session_nmk{0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08,
+                                                      0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f, 0x10};
+
+        Nmk const* session_nmk = &ctx.slac_config.session_nmk;
+        if (ctx.slac_config.link_status.debug_simulate_failed_matching) {
+            ctx.log_info("Sending wrong NMK to EV to simulate a failed link setup after match request");
+            session_nmk = &failed_match_session_nmk;
+        }
+
+        data.create_cm_slac_match_cnf(reply, *msg, *session_nmk);
+        if (not ctx.send_slac_message(data.ev_mac, reply)) {
+            ctx.log_warn("Failed to send CM_SLAC_MATCH.CNF");
+        }
+        ctx.signal_cm_slac_match_cnf(data.ev_mac.data());
+        ctx.cache_match_confirm_message(reply, data.ev_mac, data.evse_mac, data.run_id);
+        std::copy(std::begin(data.ev_mac), std::end(data.ev_mac), std::begin(ctx.status.ev_mac));
+    }
+};
+
+struct WaitAttenRsp : SessionLevelState<StateId::SessionWaitAttenRsp> {
+    explicit WaitAttenRsp(Session& s) :
+        SessionLevelState(s, "WaitAttenRsp", std::chrono::milliseconds(defs::TT_MATCH_RESPONSE_MS)) {
+    }
+    Result feed(Event const& e) override {
+        auto& data = session.session_data;
+        if (e.is(EventId::update)) {
+            if (not timed_out()) {
+                return unhandled();
+            }
+            if (data.num_retries >= defs::C_EV_MATCH_RETRY) {
+                log_failed("No CM_ATTEN_CHAR.RSP after all retries, session failed");
+                return transition(make_session_failed());
+            }
+            ctx.log_info(session_log_prefix(data) +
+                         "No CM_ATTEN_CHAR.RSP yet, retransmitting CM_ATTEN_CHAR.IND (retry " +
+                         std::to_string(data.num_retries + 1) + " of " + std::to_string(defs::C_EV_MATCH_RETRY) + ")");
+            send_atten_char(session);
+            data.num_retries++;
+            return transition(std::make_unique<WaitAttenRsp>(session));
+        }
+        if (matches_atten_char_rsp(e, data)) {
+            ctx.log_info(session_log_prefix(data) + "Received CM_ATTEN_CHAR.RSP, waiting for CM_SLAC_MATCH.REQ");
+            return transition(std::make_unique<WaitSlacMatch>(session));
+        }
+        return unhandled();
+    }
+};
+
+struct FinalizeSounding : SessionLevelState<StateId::SessionFinalizeSounding> {
+    static constexpr auto FINALIZE_SOUNDING_DELAY_MS = 45;
+    explicit FinalizeSounding(Session& s) :
+        SessionLevelState(s, "FinalizeSounding", std::chrono::milliseconds(FINALIZE_SOUNDING_DELAY_MS)) {
+    }
+    Result feed(Event const& e) override {
+        if (e.is(EventId::update) and timed_out()) {
+            ctx.log_info(session_log_prefix(session.session_data) + "Finalize sounding, sending CM_ATTEN_CHAR.IND");
+            send_atten_char(session);
+            return transition(std::make_unique<WaitAttenRsp>(session));
+        }
+        return unhandled();
+    }
+};
+
+struct Sounding : SessionLevelState<StateId::SessionSounding> {
+    explicit Sounding(Session& s) :
+        SessionLevelState(s, "Sounding", std::chrono::milliseconds(defs::TT_EVSE_MATCH_MNBC_MS)) {
+    }
+    // Accumulate one CM_ATTEN_PROFILE.IND.
+    void capture_sound(Event const& e) {
+        auto& data = session.session_data;
+        auto const msg = e.payload->payload_as<messages::cm_atten_profile_ind>();
+        if (not msg.has_value()) {
+            return;
+        }
+        for (int i = 0; i < defs::AAG_LIST_LEN; ++i) {
+            data.captured_aags[i] += msg->aag[i];
+        }
+        data.captured_sounds++;
+        ctx.log_debug(session_log_prefix(data) + "Received CM_ATTEN_PROFILE.IND (" +
+                      std::to_string(data.captured_sounds) + " of " +
+                      std::to_string(defs::CM_SLAC_PARM_CNF_NUM_SOUNDS) + " sounds captured)");
+        if (data.captured_sounds >= defs::CM_SLAC_PARM_CNF_NUM_SOUNDS) {
+            ctx.log_info(session_log_prefix(data) + "Received all sounds, finalizing sounding");
+        }
+    }
+    Result feed(Event const& e) override {
+        auto& data = session.session_data;
+        if (e.is(EventId::update)) {
+            if (timed_out()) {
+                return transition(std::make_unique<FinalizeSounding>(session));
+            }
+            return unhandled();
+        }
+        if (not matches_atten_profile_ind(e, data)) {
+            return unhandled();
+        }
+        if (data.captured_sounds + 1 >= defs::CM_SLAC_PARM_CNF_NUM_SOUNDS) {
+            capture_sound(e);
+            return transition(std::make_unique<FinalizeSounding>(session));
+        }
+        capture_sound(e);
+        return handled();
+    }
+};
+
+struct WaitStartAtten : SessionLevelState<StateId::SessionWaitStartAtten> {
+    explicit WaitStartAtten(Session& s) :
+        SessionLevelState(s, "WaitStartAtten", std::chrono::milliseconds(defs::TT_MATCH_SEQUENCE_MS)) {
+    }
+    Result feed(Event const& e) override {
+        if (e.is(EventId::update)) {
+            if (timed_out()) {
+                log_failed("Timeout waiting for CM_START_ATTEN_CHAR.IND, session failed");
+                return transition(make_session_failed());
+            }
+            return unhandled();
+        }
+        if (not timed_out() and matches_start_atten_char(e, session.session_data)) {
+            ctx.log_info(session_log_prefix(session.session_data) +
+                         "Received CM_START_ATTEN_CHAR.IND, MNBC sounding started");
+            return transition(std::make_unique<Sounding>(session));
+        }
+        return unhandled();
+    }
+};
+
+} // namespace
+
+void Session::start() {
+    session_data.num_retries = 0;
+    region.start(std::make_unique<WaitStartAtten>(*this));
+}
