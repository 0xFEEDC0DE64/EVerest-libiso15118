-    template <class Fsm, class Evt, class SrcT, class TarT> bool operator()(Evt const& e, Fsm& fsm, SrcT&, TarT&) {
-        if (e.payload.get_mmtype() != (defs::MMTYPE_CM_SLAC_MATCH | defs::MMTYPE_MODE_REQ)) {
