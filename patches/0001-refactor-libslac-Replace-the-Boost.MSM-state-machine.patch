-// WaitForLink sub-machine: after CM_SLAC_MATCH.CNF, poll the modem until it reports the AVLN as
-// linked (or the link-status timeout elapses). Re-sends the cached CM_SLAC_MATCH.CNF on request.
-
-#pragma once
-#include "../../msm_helpers.hpp"
-#include "common.hpp"
-#include "guards_and_actions/wait_for_link_logic.hpp"
-
-#include <everest/slac/fsm/evse/context.hpp>
-#include <everest/slac/telemetry.hpp>
-#include <everest/slac/timer.hpp>
-
-#include <boost/mpl/vector.hpp>
-#include <boost/msm/front/completion_event.hpp>
-#include <boost/msm/front/functor_row.hpp>
-#include <boost/msm/front/state_machine_def.hpp>
-#include <boost/msm/front/states.hpp>
-
-#include <chrono>
-
-namespace everest::lib::slac::msm::wait_for_link_sm {
-
-struct WaitForLink_def : public state_machine_def<WaitForLink_def> {
-    // States
-    // clang-format off
-    struct Init          : public state<> { };
-    struct NoDetect      : public state<> { };
-    struct Failed        : public exit_pseudo_state<none> { };
-    struct Matched       : public exit_pseudo_state<message> { };
-    // clang-format on
-
-    // Transitions
-    // Rows sharing Init and the completion event must be mutually exclusive (msm_helpers.hpp); a
-    // vendor without a link status query fails at once.
-    using no_link_status = And_<Not_<is_lumissil>, Not_<is_qualcomm>>;
-
-    using initial_state = Init;
-    // clang-format off
-    struct transition_table : boost::mpl::vector<
-        //    +----------+---------+----------+-----------------+-----------------+
-        //    | Source   | Event   | Target   | Action          | Guard           |
-        //    +----------+---------+----------+-----------------+-----------------+
-        Row   < Init     , none    , Failed   , none            , no_link_status  >,
-        Row   < Init     , none    , Lumissil , link_status_req , is_lumissil     >,
-        Row   < Init     , none    , Qualcomm , link_status_req , is_qualcomm     >,
-        //    +----------+---------+----------+-----------------+-----------------+
-        Row   < Lumissil , update  , none     , link_status_req , timeout         >,
-        Row   < Lumissil , message , none     , send_match_cnf  , is_match_req    >,
-        Row   < Lumissil , message , Matched  , none            , link_status_cnf >,
-        //    +----------+---------+----------+-----------------+-----------------+
-        Row   < Qualcomm , update  , none     , link_status_req , timeout         >,
-        Row   < Qualcomm , message , none     , send_match_cnf  , is_match_req    >,
-        Row   < Qualcomm , message , Matched  , none            , link_status_cnf >
-        //    +----------+---------+----------+-----------------+-----------------+
-        >{};
-    // clang-format on
-
-    // No try/catch around the event: the callbacks the machine calls never throw (the context parks
-    // their failures, see rethrow_recorded), so a throw here is a bug and must not be swallowed.
-    typedef int no_exception_thrown;
-    template <class FSM, class Event> void no_transition(Event const&, FSM&, int) {
-    }
-
-    // Entry / exit
-    template <class Event, class Fsm> void on_entry(Event const&, Fsm& fsm) {
-        ctx = fsm.ctx;
-        // Still in the matching phase (post CM_SLAC_MATCH.CNF, awaiting link) -> published as MATCHING.
-        ctx->enter_state(SlacState::WaitForLink, D3State::Matching, "Waiting for Link to be ready...");
-        link_check_to = ctx->slac_config.link_status.retry;
-        to.arm(ctx->current_time, ctx->slac_config.link_status.timeout);
-    }
-
-    // Members
-    fsm::evse::Context* ctx;
-    std::chrono::milliseconds link_check_to{0};
-    timer to;
-    bool state_timeout(timer::tp now) const {
-        return to.expired(now);
-    }
-    void deadlines(earliest_deadline& next) const {
-        next.offer(to);
-    }
-};
-static_assert(has_deadlines<WaitForLink_def>::value);
-
-} // namespace everest::lib::slac::msm::wait_for_link_sm
diff --git a/slac/src/fsm/evse/reset.cpp b/slac/src/fsm/evse/reset.cpp
new file mode 100644
index 0000000..47bd51c
--- /dev/null
+++ b/slac/src/fsm/evse/reset.cpp
@@ -0,0 +1,238 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Pionix GmbH and Contributors to EVerest
+
+// Reset sub-machine: (re)generates the NMK and programs it into the modem with CM_SET_KEY.REQ,
+// then exits to ResetChip or Idle.
+//
+//   Init --completion / send CM_SET_KEY.REQ--> MsgSent
+//   MsgSent --update/timeout, attempts left / resend--> MsgSent          (retry_confirmed only)
+//   MsgSent --update/timeout, no attempts left--> MsgValid               (retry_confirmed only)
+//   MsgSent --message(CM_SET_KEY.CNF ok)--> MsgValid
+//   MsgSent --message(CM_SET_KEY.CNF failed), attempts left--> MsgSent   (retry_confirmed only)
+//   MsgSent --message(CM_SET_KEY.CNF failed), no attempts left--> MsgValid (retry_confirmed only)
+//   MsgValid --update--> ResetChip (exit) | Idle (exit)
+//   outer:  reset --> Reset;  ResetChip exit --> ResetChip;  Idle exit --> Idle;
+//           update/set-key timeout in legacy_single_attempt mode --> Failed
+
+#include "../misc.hpp"
+#include "machine.hpp"
+
+#include <everest/slac/EvseSlacConfig.hpp>
+#include <everest/slac/MatchingSessionData.hpp>
+#include <everest/slac/slac_defs.hpp>
+#include <everest/slac/slac_messages.hpp>
+#include <everest/slac/telemetry.hpp>
+
+#include <string>
+
+namespace everest::lib::slac::sm::evse {
+
+namespace {
+
+using fsm::evse::SetKeyHandlingMode;
+
+bool is_retry_confirmed(fsm::evse::Context& ctx) {
+    return ctx.slac_config.set_key_handling_mode == SetKeyHandlingMode::retry_confirmed;
+}
+bool is_legacy_set_key_handling_mode(fsm::evse::Context& ctx) {
+    return ctx.slac_config.set_key_handling_mode == SetKeyHandlingMode::legacy_single_attempt;
+}
+bool has_set_key_attempts_left(SlacMachine& m) {
+    return m.reset_data.set_key_attempts < m.ctx.slac_config.set_key_max_attempts;
+}
+bool set_key_timeout(SlacMachine& m) {
+    return m.reset_data.set_key_timer.expired(m.ctx.current_time);
+}
+bool is_set_key_cnf(Event const& e) {
+    return is_message_of_type(e, defs::MMTYPE_CM_SET_KEY | defs::MMTYPE_MODE_CNF) and
+           e.payload->payload_as<messages::cm_set_key_cnf>().has_value();
+}
+bool is_set_key_cnf_success(SlacMachine& m, Event const& e) {
+    if (not is_set_key_cnf(e)) {
+        return false;
+    }
+    auto const msg = e.payload->payload_as<messages::cm_set_key_cnf>();
+    return accepts_set_key_cnf_success_result(m.ctx.slac_config.set_key_cnf_success_mode, msg->result);
+}
+bool is_set_key_cnf_failed(SlacMachine& m, Event const& e) {
+    if (not is_set_key_cnf(e)) {
+        return false;
+    }
+    auto const msg = e.payload->payload_as<messages::cm_set_key_cnf>();
+    return not accepts_set_key_cnf_success_result(m.ctx.slac_config.set_key_cnf_success_mode, msg->result);
+}
+
+// Decide which NMK the upcoming CM_SET_KEY.REQ carries. With regenerate_key_on_reset a fresh key is
+// generated: into pending_nmk in retry_confirmed mode (it becomes the session key only once the
+// modem confirmed it, see apply_set_key_cnf) or straight into the session key otherwise. Without
+// regeneration the current session key is re-sent. legacy_single_attempt always sends the session
+// key. Also arms the first attempt.
+void select_nmk_for_reset(SlacMachine& m) {
+    auto& config = m.ctx.slac_config;
+    auto& data = m.reset_data;
+    if (config.regenerate_key_on_reset) {
+        if (config.set_key_handling_mode == SetKeyHandlingMode::retry_confirmed) {
+            config.generate_nmk(data.pending_nmk);
+        } else {
+            config.generate_nmk(config.session_nmk);
+        }
+    } else {
+        data.pending_nmk = config.session_nmk;
+    }
+    if (config.set_key_handling_mode == SetKeyHandlingMode::legacy_single_attempt) {
+        data.pending_nmk = config.session_nmk;
+    }
+    data.set_key_attempts = 1;
+}
+
+void send_set_key_req(SlacMachine& m) {
+    auto& ctx = m.ctx;
+    Nmk const& nmk = is_retry_confirmed(ctx) ? m.reset_data.pending_nmk : ctx.slac_config.session_nmk;
+    ctx.log_info("Using SLAC session NMK " + format_session_nmk_for_log(nmk));
+    auto msg = fsm::evse::MatchingSessionData::create_cm_set_key_req(nmk);
+    m.reset_data.set_key_timer.arm(ctx.current_time, ctx.slac_config.set_key_timeout);
+    if (not ctx.send_slac_message(ctx.slac_config.plc_peer_mac, msg)) {
+        ctx.log_warn("Failed to send CM_SET_KEY.REQ");
+    }
+}
+
+struct MsgValid : InnerLevelState<StateId::ResetMsgValid> {
+    explicit MsgValid(SlacMachine& m) : InnerLevelState(m, "MsgValid") {
+    }
+    bool reacts_to(EventId e) const override {
+        return e == EventId::update;
+    }
+    Result feed(Event const& e) override {
+        if (not e.is(EventId::update)) {
+            return unhandled();
+        }
+        if (not ctx.slac_config.chip_reset.enabled) {
+            return transition(std::make_unique<ExitPoint<StateId::ResetExitIdle>>(machine, "Idle", EventId::update, e));
+        }
+        return transition(
+            std::make_unique<ExitPoint<StateId::ResetExitResetChip>>(machine, "ResetChip", EventId::update, e));
+    }
+};
+
+struct MsgSent : InnerLevelState<StateId::ResetMsgSent> {
+    explicit MsgSent(SlacMachine& m) : InnerLevelState(m, "MsgSent") {
+    }
+    bool reacts_to(EventId e) const override {
+        return reacts_to_any(e, {EventId::update, EventId::message});
+    }
+    Result feed(Event const& e) override {
+        auto& data = machine.reset_data;
+        auto const& config = ctx.slac_config;
+        if (e.is(EventId::update)) {
+            if (not(set_key_timeout(machine) and is_retry_confirmed(ctx))) {
+                return unhandled();
+            }
+            if (not has_set_key_attempts_left(machine)) {
+                ctx.log_error("CM_SET_KEY timeout without valid CM_SET_KEY.CNF after " +
+                              std::to_string(config.set_key_max_attempts) + " attempts; continuing to reset/idle path");
+                return transition(std::make_unique<MsgValid>(machine));
+            }
+            data.set_key_attempts++;
+            ctx.log_warn("Retrying CM_SET_KEY.REQ due to timeout. Attempt " + std::to_string(data.set_key_attempts) +
+                         " of " + std::to_string(config.set_key_max_attempts));
+            send_set_key_req(machine);
+            return transition(std::make_unique<MsgSent>(machine));
+        }
+        if (e.is(EventId::message)) {
+            if (is_set_key_cnf_failed(machine, e) and is_retry_confirmed(ctx)) {
+                auto const reply = e.payload->payload_as<messages::cm_set_key_cnf>();
+                if (not has_set_key_attempts_left(machine)) {
+                    ctx.log_error("CM_SET_KEY.CNF indicates failure with result=" + std::to_string(reply->result) +
+                                  " after maximum attempts; continuing to reset/idle path");
+                    return transition(std::make_unique<MsgValid>(machine));
+                }
+                ctx.log_warn("CM_SET_KEY.CNF indicates failure with result=" + std::to_string(reply->result) +
+                             " on attempt " + std::to_string(data.set_key_attempts) + "; retrying after timeout (max " +
+                             std::to_string(config.set_key_max_attempts) + ")");
+                return transition(std::make_unique<MsgSent>(machine));
+            }
+            if (is_set_key_cnf_success(machine, e)) {
+                ctx.slac_config.session_nmk = data.pending_nmk;
+                ctx.log_info("CM_SET_KEY.CNF success, NMK set on modem");
+                ctx.status.modem_NMK = true;
+                return transition(std::make_unique<MsgValid>(machine));
+            }
+        }
+        return unhandled();
+    }
+};
+
+struct ResetInit : InnerLevelState<StateId::ResetInit> {
+    explicit ResetInit(SlacMachine& m) : InnerLevelState(m, "Init") {
+    }
+    bool reacts_to(EventId e) const override {
+        return e == EventId::completion;
+    }
+    Result feed(Event const& e) override {
+        if (e.is(EventId::completion)) {
+            send_set_key_req(machine);
+            return transition(std::make_unique<MsgSent>(machine));
+        }
+        return unhandled();
+    }
+};
+
+struct Reset : TopLevelState<StateId::Reset> {
+    explicit Reset(SlacMachine& m) : TopLevelState(m, "Reset_def") {
+    }
+    void enter() override {
+        select_nmk_for_reset(machine);
+        ctx.enter_state(SlacState::Reset, D3State::Unmatched, "Entered Reset state");
+        ctx.clear_match_confirm_cache();
+        ctx.status.modem_NMK = false;
+        region.start(std::make_unique<ResetInit>(machine));
+        region.complete();
+    }
+    void leave() override {
+        region.stop();
+    }
+    Result feed(Event const& e) override {
+        if (region.feed(e)) {
+            region.complete();
+            return handled();
+        }
+        if (e.is(EventId::reset)) {
+            return transition(make_reset(machine));
+        }
+        if (e.is(EventId::update)) {
+            if (region.current_id() == static_cast<int>(StateId::ResetExitIdle)) {
+                return transition(make_idle(machine));
+            }
+            if (region.current_id() == static_cast<int>(StateId::ResetExitResetChip)) {
+                return transition(make_reset_chip(machine));
+            }
+            if (set_key_timeout(machine) and is_legacy_set_key_handling_mode(ctx)) {
+                return transition(make_failed(machine));
+            }
+        }
+        return unhandled();
+    }
+    void deadlines(earliest_deadline& next) const override {
+        next.offer(machine.reset_data.set_key_timer);
+    }
+    bool reacts_to(EventId e) const override {
+        return reacts_to_any(e, {EventId::reset, EventId::update}) or region.current().reacts_to(e);
+    }
+    bool is_submachine() const override {
+        return true;
+    }
+    void traverse_children(Visitor& visitor, std::size_t depth) const override {
+        region.traverse(visitor, depth);
+    }
+
+private:
+    InnerRegion region;
+};
+
+} // namespace
+
+TopStatePtr make_reset(SlacMachine& machine) {
+    return std::make_unique<Reset>(machine);
+}
+
+} // namespace everest::lib::slac::sm::evse
diff --git a/slac/src/fsm/evse/reset_chip.cpp b/slac/src/fsm/evse/reset_chip.cpp
new file mode 100644
index 0000000..a79a828
--- /dev/null
+++ b/slac/src/fsm/evse/reset_chip.cpp
@@ -0,0 +1,165 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Pionix GmbH and Contributors to EVerest
+
+// ResetChip sub-machine: optional modem reset after the NMK was programmed (Reset -> ResetChip -> Idle).
+//
+//   Delay --update/timeout / send reset request--> Sent
+//   Sent --message(CM_RESET_DEVICE.CNF)--> Received
+//   Sent --update / Lumissil (no reply), unsupported modem, or timeout--> Done (exit)
+//   Received --update--> Done (exit)
+//   outer:  reset --> Reset;  Done exit --> Idle
+
+#include "machine.hpp"
+
+#include <everest/slac/slac_defs.hpp>
+#include <everest/slac/slac_messages.hpp>
+#include <everest/slac/telemetry.hpp>
+
+namespace everest::lib::slac::sm::evse {
+
+namespace {
+
+using DoneExit = ExitPoint<StateId::ResetChipDone>;
+
+std::unique_ptr<InnerState> make_done(SlacMachine& m, Event const& e) {
+    return std::make_unique<DoneExit>(m, "Done", EventId::update, e);
+}
+
+void send_reset_request(fsm::evse::Context& ctx) {
+    if (ctx.modem_vendor == defs::ModemVendor::Qualcomm) {
+        messages::qualcomm::cm_reset_device_req reset_req{};
+        ctx.log_info("Resetting HW chip using CM_RESET_DEVICE.REQ");
+        if (not ctx.send_slac_message(ctx.slac_config.plc_peer_mac, reset_req)) {
+            ctx.log_warn("Failed to send CM_RESET_DEVICE.REQ");
+        }
+    } else if (ctx.modem_vendor == defs::ModemVendor::Lumissil) {
+        messages::lumissil::nscm_reset_device_req reset_req{};
+        if (not ctx.send_slac_message(ctx.slac_config.plc_peer_mac, reset_req)) {
+            ctx.log_warn("Failed to send NSCM_RESET_DEVICE.REQ");
+        }
+    } else {
+        ctx.log_warn("Chip reset is not supported on this modem, skipping it");
+    }
+}
+
+struct Received : InnerLevelState<StateId::ResetChipReceived> {
+    explicit Received(SlacMachine& m) : InnerLevelState(m, "Received") {
+    }
+    bool reacts_to(EventId e) const override {
+        return e == EventId::update;
+    }
+    Result feed(Event const& e) override {
+        if (e.is(EventId::update)) {
+            return transition(make_done(machine, e));
+        }
+        return unhandled();
+    }
+};
+
+struct Sent : InnerLevelState<StateId::ResetChipSent> {
+    explicit Sent(SlacMachine& m) : InnerLevelState(m, "Sent") {
+    }
+    bool reacts_to(EventId e) const override {
+        return reacts_to_any(e, {EventId::update, EventId::message});
+    }
+    void enter() override {
+        state_timer.duration = ctx.slac_config.chip_reset.timeout;
+        state_timer.arm(ctx.current_time);
+    }
+    void deadlines(earliest_deadline& next) const override {
+        state_timer.deadlines(next);
+    }
+    Result feed(Event const& e) override {
+        if (e.is(EventId::message)) {
+            if (e.payload->get_mmtype() == (defs::qualcomm::MMTYPE_CM_RESET_DEVICE | defs::MMTYPE_MODE_CNF)) {
+                return transition(std::make_unique<Received>(machine));
+            }
+            return unhandled();
+        }
+        if (not e.is(EventId::update)) {
+            return unhandled();
+        }
+        if (state_timer.state_timeout(ctx.current_time)) {
+            ctx.log_error("Reset timeout, no CM_RESET_DEVICE.CNF received - failed to confirm the chip reset");
+            return transition(make_done(machine, e));
+        }
+        // Only Qualcomm answers the reset (handled via Received): the Lumissil CG5317 does not reply
+        // to the reset packet, and an unsupported chip was not reset at all.
+        if (ctx.modem_vendor != defs::ModemVendor::Qualcomm) {
+            return transition(make_done(machine, e));
+        }
+        return unhandled();
+    }
+
+private:
+    StateTimer state_timer;
+};
+
+struct Delay : InnerLevelState<StateId::ResetChipDelay> {
+    explicit Delay(SlacMachine& m) : InnerLevelState(m, "Delay") {
+    }
+    bool reacts_to(EventId e) const override {
+        return e == EventId::update;
+    }
+    void enter() override {
+        state_timer.duration = ctx.slac_config.chip_reset.delay;
+        state_timer.arm(ctx.current_time);
+    }
+    void deadlines(earliest_deadline& next) const override {
+        state_timer.deadlines(next);
+    }
+    Result feed(Event const& e) override {
+        if (e.is(EventId::update) and state_timer.state_timeout(ctx.current_time)) {
+            send_reset_request(ctx);
+            return transition(std::make_unique<Sent>(machine));
+        }
+        return unhandled();
+    }
+
+private:
+    StateTimer state_timer;
+};
+
+struct ResetChip : TopLevelState<StateId::ResetChip> {
+    explicit ResetChip(SlacMachine& m) : TopLevelState(m, "ResetChip_def") {
+    }
+    void enter() override {
+        ctx.enter_state(SlacState::ResetChip, D3State::Unmatched);
+        region.start(std::make_unique<Delay>(machine));
+    }
+    void leave() override {
+        region.stop();
+    }
+    Result feed(Event const& e) override {
+        if (region.feed(e)) {
+            return handled();
+        }
+        if (e.is(EventId::reset)) {
+            return transition(make_reset(machine));
+        }
+        if (e.is(EventId::update) and region.current_id() == static_cast<int>(StateId::ResetChipDone)) {
+            return transition(make_idle(machine));
+        }
+        return unhandled();
+    }
+    bool reacts_to(EventId e) const override {
+        return e == EventId::reset or region.current().reacts_to(e);
+    }
+    bool is_submachine() const override {
+        return true;
+    }
+    void traverse_children(Visitor& visitor, std::size_t depth) const override {
+        region.traverse(visitor, depth);
+    }
+
+private:
+    InnerRegion region;
+};
+
+} // namespace
+
+TopStatePtr make_reset_chip(SlacMachine& machine) {
+    return std::make_unique<ResetChip>(machine);
+}
+
+} // namespace everest::lib::slac::sm::evse
diff --git a/slac/src/fsm/evse/wait_for_link.cpp b/slac/src/fsm/evse/wait_for_link.cpp
new file mode 100644
index 0000000..1f0542e
--- /dev/null
+++ b/slac/src/fsm/evse/wait_for_link.cpp
@@ -0,0 +1,182 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Pionix GmbH and Contributors to EVerest
+
+// WaitForLink sub-machine: after CM_SLAC_MATCH.CNF, poll the modem until it reports the AVLN as
+// linked (or the link-status timeout elapses). Re-sends the cached CM_SLAC_MATCH.CNF on request.
+//
+//   Init --completion / query link status--> Lumissil | Qualcomm;  no link status query --> Failed (exit)
+//   Lumissil|Qualcomm --update/poll due / query again--> (internal)
+//   Lumissil|Qualcomm --message(CM_SLAC_MATCH.REQ) / resend cached CM_SLAC_MATCH.CNF--> (internal)
+//   Lumissil|Qualcomm --message(link status: linked)--> Matched (exit)
+//   outer:  update/link-status timeout --> Failed; reset, leave_bcd --> Reset;
+//           Failed exit --> Failed;  Matched exit --> Matched
+
+#include "../misc.hpp"
+#include "link_status.hpp"
+#include "machine.hpp"
+
+#include <everest/slac/MatchingSessionData.hpp>
+#include <everest/slac/slac_defs.hpp>
+#include <everest/slac/slac_messages.hpp>
+#include <everest/slac/telemetry.hpp>
+
+namespace everest::lib::slac::sm::evse {
+
+namespace {
+
+bool is_match_req(fsm::evse::Context& ctx, Event const& e) {
+    if (not e.is(EventId::message)) {
+        return false;
+    }
+    if (e.payload->get_mmtype() != (defs::MMTYPE_CM_SLAC_MATCH | defs::MMTYPE_MODE_REQ)) {
+        return false;
+    }
+    auto const msg = e.payload->payload_as<messages::cm_slac_match_req>();
+    if (not msg.has_value()) {
+        return false;
+    }
+    if (not ctx.match_confirm_cache.valid) {
+        return false;
+    }
+    auto const source_mac = e.payload->get_src_mac();
+    if (source_mac == nullptr) {
+        return false;
+    }
+    if (not wire_pointer_equal(source_mac, ctx.match_confirm_cache.ev_mac)) {
+        return false;
+    }
+    fsm::evse::MatchingSessionData data(ctx.match_confirm_cache.ev_mac, ctx.match_confirm_cache.run_id,
+                                        ctx.match_confirm_cache.evse_mac);
+    return data.validate_message(*msg);
+}
+
+void send_match_cnf(fsm::evse::Context& ctx) {
+    if (not ctx.match_confirm_cache.valid) {
+        return;
+    }
+    if (not ctx.send_slac_message(ctx.match_confirm_cache.ev_mac, ctx.match_confirm_cache.message)) {
+        ctx.log_warn("Failed to send cached CM_SLAC_MATCH.CNF");
+    }
+}
+
+template <class Vendor, StateId Id> struct CheckLink : LinkCheckState<Vendor, Id> {
+    explicit CheckLink(SlacMachine& m) : LinkCheckState<Vendor, Id>(m, m.wait_for_link_data.link_check_to) {
+    }
+    typename CheckLink::Result feed(Event const& e) override {
+        if (e.is(EventId::update)) {
+            if (this->poll_due()) {
+                this->poll();
+                return this->handled();
+            }
+            return this->unhandled();
+        }
+        if (this->link_status_cnf(e)) {
+            return this->transition(std::make_unique<ExitPoint<StateId::WaitForLinkExitMatched>>(
+                this->machine, "Matched", EventId::message, e));
+        }
+        if (is_match_req(this->ctx, e)) {
+            send_match_cnf(this->ctx);
+            return this->handled();
+        }
+        return this->unhandled();
+    }
+};
+using Lumissil = CheckLink<LumissilLinkStatus, StateId::WaitForLinkLumissil>;
+using Qualcomm = CheckLink<QualcommLinkStatus, StateId::WaitForLinkQualcomm>;
+
+struct WaitForLinkInit : InnerLevelState<StateId::WaitForLinkInit> {
+    explicit WaitForLinkInit(SlacMachine& m) : InnerLevelState(m, "Init") {
+    }
+    bool reacts_to(EventId e) const override {
+        return e == EventId::completion;
+    }
+    template <class Target> Result start_polling() {
+        auto target = std::make_unique<Target>(machine);
+        target->poll();
+        return transition(std::move(target));
+    }
+    Result feed(Event const& e) override {
+        if (not e.is(EventId::completion)) {
+            return unhandled();
+        }
+        if (ctx.modem_vendor == defs::ModemVendor::Qualcomm) {
+            return start_polling<Qualcomm>();
+        }
+        if (ctx.modem_vendor == defs::ModemVendor::Lumissil) {
+            return start_polling<Lumissil>();
+        }
+        // A vendor without a link status query fails at once.
+        return transition(
+            std::make_unique<ExitPoint<StateId::WaitForLinkExitFailed>>(machine, "Failed", EventId::completion, e));
+    }
+};
+
+struct WaitForLink : TopLevelState<StateId::WaitForLink> {
+    explicit WaitForLink(SlacMachine& m) : TopLevelState(m, "WaitForLink_def") {
+    }
+    void enter() override {
+        auto& data = machine.wait_for_link_data;
+        // Still in the matching phase (post CM_SLAC_MATCH.CNF, awaiting link) -> published as MATCHING.
+        ctx.enter_state(SlacState::WaitForLink, D3State::Matching, "Waiting for Link to be ready...");
+        data.link_check_to = ctx.slac_config.link_status.retry;
+        data.to.arm(ctx.current_time, ctx.slac_config.link_status.timeout);
+        region.start(std::make_unique<WaitForLinkInit>(machine));
+        region.complete();
+    }
+    void leave() override {
+        region.stop();
+    }
+    Result feed(Event const& e) override {
+        if (region.feed(e)) {
+            region.complete();
+            return handled();
+        }
+        auto const exit = region.current_id();
+        switch (e.id) {
+        case EventId::update:
+            if (machine.wait_for_link_data.to.expired(ctx.current_time)) {
+                return transition(make_failed(machine));
+            }
+            break;
+        case EventId::reset:
+        case EventId::leave_bcd:
+            return transition(make_reset(machine));
+        case EventId::completion:
+            if (exit == static_cast<int>(StateId::WaitForLinkExitFailed)) {
+                return transition(make_failed(machine));
+            }
+            break;
+        case EventId::message:
+            if (exit == static_cast<int>(StateId::WaitForLinkExitMatched)) {
+                return transition(make_matched(machine));
+            }
+            break;
+        default:
+            break;
+        }
+        return unhandled();
+    }
+    void deadlines(earliest_deadline& next) const override {
+        next.offer(machine.wait_for_link_data.to);
+    }
+    bool reacts_to(EventId e) const override {
+        return reacts_to_any(e, {EventId::update, EventId::reset, EventId::leave_bcd}) or region.current().reacts_to(e);
+    }
+    bool is_submachine() const override {
+        return true;
+    }
+    void traverse_children(Visitor& visitor, std::size_t depth) const override {
+        region.traverse(visitor, depth);
+    }
+
+private:
+    InnerRegion region;
+};
+
+} // namespace
+
+TopStatePtr make_wait_for_link(SlacMachine& machine) {
+    return std::make_unique<WaitForLink>(machine);
+}
+
+} // namespace everest::lib::slac::sm::evse
diff --git a/slac/src/fsm/fsm_helpers.hpp b/slac/src/fsm/fsm_helpers.hpp
new file mode 100644
index 0000000..05d1cd5
--- /dev/null
+++ b/slac/src/fsm/fsm_helpers.hpp
@@ -0,0 +1,301 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Pionix GmbH and Contributors to EVerest
+
+// Building blocks shared by the EVSE and EV SLAC state machines, which are written on top of
+// fsm::v2 (everest/util/fsm/fsm.hpp, namespace ::fsm::v2).
+//
+// Execution model (kept identical to the previous Boost.MSM implementation):
+// - A sub-machine is a state that owns one or more regions, each a flat fsm::v2::FSM. An event is
+//   offered to every region first, in region order; only when no region handles it does the
+//   sub-machine's own (outer) transition table see it.
+// - Rows sharing a source and an event are tried in reverse table order. Every table keeps them
+//   mutually exclusive, so nothing may rely on that order.
+// - The completion event stands for the anonymous (eventless) transitions: it is fed after every
+//   handled event, and on entry of a sub-machine, until no further transition fires.
+// - Entering an exit point queues its event at the top-level machine, which processes the queue
+//   once the current event, completion transitions included, has been dealt with. The outer
+//   table then picks up the exit through the exit point being the region's active state.
+// - Data of a sub-machine lives outside the state objects and survives leaving and re-entering
+//   the sub-machine; state objects only hold their own timers.
+
+#pragma once
+
+#include <everest/slac/HomeplugMessage.hpp>
+#include <everest/slac/timer.hpp>
+#include <everest/util/fsm/fsm.hpp>
+
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <exception>
+#include <memory>
+#include <optional>
+#include <stdexcept>
+#include <utility>
+#include <vector>
+
+namespace everest::lib::slac::sm {
+
+// Events
+enum class EventId : std::uint8_t {
+    update,
+    message,
+    reset,
+    enter_bcd,
+    leave_bcd,
+    trigger_matching,
+    completion, // anonymous transitions, see above
+};
+
+struct Event {
+    EventId id;
+    messages::HomeplugMessage const* payload{nullptr}; // set for EventId::message
+
+    bool is(EventId other) const {
+        return id == other;
+    }
+};
+
+// An event kept for later, owning its payload (exit point forwarding).
+struct QueuedEvent {
+    EventId id;
+    std::optional<messages::HomeplugMessage> payload;
+
+    explicit QueuedEvent(Event const& e) : id(e.id) {
+        if (e.payload != nullptr) {
+            payload = *e.payload;
+        }
+    }
+    Event view() const {
+        return {id, payload ? &*payload : nullptr};
+    }
+};
+
+struct Node;
+
+// Walks the active states, the sub-machines' regions and the dynamic sessions.
+struct Visitor {
+    virtual ~Visitor() = default;
+    virtual void on_active_state(Node const&, std::size_t /*depth*/) {
+    }
+    virtual void on_submachine_start(std::size_t /*depth*/) {
+    }
+    virtual void on_submachine_end(std::size_t /*depth*/) {
+    }
+    virtual void on_dynamic_sessions_size(std::size_t) {
+    }
+    virtual void on_dynamic_session_start(int /*index*/, std::size_t /*depth*/) {
+    }
+    virtual void on_dynamic_session_end(int /*index*/, std::size_t /*depth*/) {
+    }
+};
+
+// What every state exposes besides fsm::v2's enter/feed/leave.
+struct Node {
+    virtual ~Node() = default;
+    // Short type name, as reported in the state printout and the FSM telemetry.
+    virtual char const* name() const = 0;
+    // Stable id per state type: equal ids mean the same state, also across a self-transition.
+    virtual int id() const = 0;
+    virtual void deadlines(earliest_deadline&) const {
+    }
+    // Whether the state has transitions for the event at all, taken or not (their guards may
+    // reject it). Of a sub-machine, this includes its regions' active states. An event no active
+    // state reacts to is reported as ignored; exit point transitions do not count.
+    virtual bool reacts_to(EventId) const {
+        return false;
+    }
+    virtual bool is_submachine() const {
+        return false;
+    }
+    virtual void traverse_children(Visitor&, std::size_t /*depth*/) const {
+    }
+};
+
+// fsm::v2 state base. Tag only keeps the state types of different machines apart.
+template <class Tag> struct State : Node {
+    using ContainerType = std::unique_ptr<State>;
+    using EventType = Event;
+
+    struct Result {
+        bool unhandled{true};
+        ContainerType new_state{nullptr};
+    };
+
+    static Result handled() {
+        return {false, nullptr};
+    }
+    static Result transition(ContainerType target) {
+        return {false, std::move(target)};
+    }
+    static Result unhandled() {
+        return {};
+    }
+
+    virtual void enter() {
+    }
+    virtual Result feed(Event const&) {
+        return unhandled();
+    }
+    virtual void leave() {
+    }
+    int get_id() const {
+        return id();
+    }
+};
+
+// One region of a (sub-)machine: an fsm::v2::FSM that can be entered and left as a whole.
+template <class Base> class Region {
+public:
+    void start(typename Base::ContainerType initial) {
+        fsm.reset();
+        fsm.emplace(std::move(initial));
+    }
+    void stop() {
+        fsm.reset();
+    }
+    bool active() const {
+        return fsm.has_value();
+    }
+    // True if the event was handled (by a transition or an internal one).
+    bool feed(Event const& e) {
+        return static_cast<bool>(fsm->feed(e));
+    }
+    // Anonymous transitions, until none fires any more.
+    void complete() {
+        while (feed(Event{EventId::completion})) {
+        }
+    }
+    int current_id() const {
+        return fsm->get_current_state_id();
+    }
+    Base const& current() const {
+        return fsm->get_current_state();
+    }
+    void traverse(Visitor& visitor, std::size_t depth) const {
+        auto const& state = current();
+        visitor.on_active_state(state, depth);
+        if (state.is_submachine()) {
+            visitor.on_submachine_start(depth);
+            state.traverse_children(visitor, depth + 1);
+            visitor.on_submachine_end(depth);
+        }
+    }
+
+private:
+    std::optional<::fsm::v2::FSM<Base>> fsm;
+};
+
+// A state's own timer, armed for `duration` on entry.
+struct StateTimer {
+    timer to;
+    std::chrono::milliseconds duration{0};
+
+    void arm(timer::tp now) {
+        to.arm(now, duration);
+    }
+    bool state_timeout(timer::tp now) const {
+        return to.expired(now);
+    }
+    void deadlines(earliest_deadline& next) const {
+        next.offer(to);
+    }
+};
+
+inline bool is_message_of_type(Event const& e, std::uint16_t mmtype) {
+    return e.is(EventId::message) and e.payload->is_valid() and e.payload->get_mmtype() == mmtype;
+}
+
+// How a throw gets out of the machines: the contexts never let a consumer callback throw into
+// the machine. A publisher, sender or logger that throws is parked in Context::caught_exception,
+// the call counts as "not done", the transition completes, and the wrapper calls
+// rethrow_recorded as soon as the event has been processed, so the failure surfaces from
+// message()/update()/reset() on a machine that is still consistent and still takes the
+// teardown's reset. Anything else that throws inside a transition (a bug) propagates.
+template <class Ctx> void rethrow_recorded(Ctx& ctx) {
+    if (ctx.caught_exception) {
+        std::exception_ptr caught;
+        std::swap(caught, ctx.caught_exception);
+        std::rethrow_exception(caught);
+    }
+}
+
+// Writes the signature over a stored one, entry by entry, and notes whether anything differed. The
+// stored vector's capacity is reused, so comparing allocates nothing once it has grown.
+struct SignatureUpdate : Visitor {
+    explicit SignatureUpdate(std::vector<int>& sig_) : sig(sig_) {
+    }
+    void on_active_state(Node const& state, std::size_t) override {
+        put(state.id());
+    }
+    void on_dynamic_sessions_size(std::size_t size) override {
+        put(static_cast<int>(size));
+    }
+    bool finish() {
+        if (pos != sig.size()) {
+            sig.resize(pos);
+            changed = true;
+        }
+        return changed;
+    }
+
+private:
+    void put(int value) {
+        if (pos == sig.size()) {
+            sig.push_back(value);
+            changed = true;
+        } else if (sig[pos] != value) {
+            sig[pos] = value;
+            changed = true;
+        }
+        ++pos;
+    }
+    std::vector<int>& sig;
+    std::size_t pos{0};
+    bool changed{false};
+};
+
+struct DeadlineVisitor : Visitor {
+    explicit DeadlineVisitor(timer::tp now) : next(now) {
+    }
+    earliest_deadline next;
+    void on_active_state(Node const& state, std::size_t) override {
+        state.deadlines(next);
+    }
+};
+
+// The signature is the list of active-state ids of the machine, its sub-machines and sessions:
+// equal signatures, same states. Brings `signature` up to date and tells whether it changed.
+template <class Machine> bool update_signature(Machine const& machine, std::vector<int>& signature) {
+    SignatureUpdate v{signature};
+    machine.traverse(v);
+    return v.finish();
+}
+
+// Wait from `now` until the earliest deadline an active state or its handlers holds, or nothing.
+template <class Machine> std::optional<timer::tick> next_wakeup_of(Machine const& machine, timer::tp now) {
+    DeadlineVisitor v{now};
+    machine.traverse(v);
+    return v.next.wait();
+}
+
+// Feeds `update` until it moves no state any more, so what the last event made true is acted on
+// now instead of at a later wake-up. Time stays frozen meanwhile, which rules out timer-driven
+// cycles; a guard-driven one would be a table bug and is reported rather than spun on.
+template <class Machine> void settle(Machine& machine) {
+    std::vector<int> signature;
+    signature.reserve(16); // the active states plus the sessions fit, so one allocation per call
+    update_signature(machine, signature);
+    for (int round = 0; round < 32; ++round) {
+        machine.process(Event{EventId::update});
+        // A callback failure parked during that update surfaces now, before another round runs and
+        // before a machine that then fails to settle could mask it with its own logic_error.
+        rethrow_recorded(machine.ctx);
+        if (not update_signature(machine, signature)) {
+            return;
+        }
+    }
+    throw std::logic_error("SLAC state machine does not settle");
+}
+
+} // namespace everest::lib::slac::sm
